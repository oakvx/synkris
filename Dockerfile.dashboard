FROM php:8.3-apache-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev     && docker-php-ext-install pdo_pgsql && apt-get install -y --no-install-recommends libcurl4-openssl-dev && docker-php-ext-install curl     && a2enmod rewrite headers     && rm -rf /var/lib/apt/lists/*
COPY deploy/apache.conf /etc/apache2/sites-available/000-default.conf
COPY deploy/license-guard.php /var/www/html/deploy/license-guard.php
COPY dashboard.php /var/www/html/dashboard.php
COPY bridge.php /var/www/html/bridge.php
COPY deploy/session.php /var/www/html/deploy/session.php
COPY dashboard /var/www/html/dashboard
