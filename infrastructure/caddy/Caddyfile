{
  # Setup locale only. Niente HTTPS automatico e niente domini esterni finche'
  # il progetto gira interamente su localhost.
  auto_https off
}

http://localhost:8090, http://127.0.0.1:8090 {
  encode zstd gzip
  reverse_proxy api:4000
}

http://localhost:8091, http://127.0.0.1:8091 {
  root * /srv/frontend
  try_files {path} /index.html
  file_server
}
