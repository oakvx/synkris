{
  # Frontend di produzione attuale: https://oakvxish.github.io/synkris
  # Caddy resta davanti all'API; il blocco app.miodominio.tld sotto e' opzionale se in futuro
  # vorrai servire anche il frontend statico dal server invece che da GitHub Pages.
  auto_https disable_redirects
}

:8080 {
  encode zstd gzip
  reverse_proxy api:4000
}

api.miodominio.tld {
  encode zstd gzip
  reverse_proxy api:4000
}

app.miodominio.tld {
  root * /srv/frontend
  try_files {path} /index.html
  file_server
}
