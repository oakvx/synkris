generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BotConnectionStatus {
  disconnected
  waiting_qr
  waiting_pairing
  connecting
  connected
  error

  @@map("bot_connection_status")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  displayName  String?       @map("display_name")
  role         String        @default("user")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  settings            UserSettings?
  botInstances        BotInstance[]
  auditEvents         AuditEvent[]
  botEvents           BotEvent[]
  pushSubscriptions   DevicePushSubscription[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique @map("user_id")
  displayName             String   @default("Portal User") @map("display_name")
  timezone                String   @default("Europe/Rome")
  locale                  String   @default("it-IT")
  preferredConnectionMode String   @default("qr") @map("preferred_connection_mode")
  phoneNumber             String?  @map("phone_number")
  notificationsEnabled    Boolean  @default(true) @map("notifications_enabled")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model DevicePushSubscription {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  endpoint     String   @unique
  subscription Json
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "ix_device_push_subscriptions_user_id")
  @@map("device_push_subscriptions")
}

model BotInstance {
  id              String              @id @default(cuid())
  userId          String              @map("user_id")
  name            String              @default("default")
  provider        String              @default("mock")
  status          BotConnectionStatus @default(disconnected)
  lastError       String?             @map("last_error")
  sessionPath     String?             @map("session_path")
  qrCodeDataUrl   String?             @map("qr_code_data_url")
  pairingCode     String?             @map("pairing_code")
  phoneNumber     String?             @map("phone_number")
  connectedAt     DateTime?           @map("connected_at")
  lastHeartbeatAt DateTime?           @map("last_heartbeat_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          BotEvent[]
  sessionMetadata BotSessionMetadata?

  @@unique([userId, name])
  @@map("bot_instances")
}

model BotSessionMetadata {
  id                String      @id @default(cuid())
  instanceId        String      @unique @map("instance_id")
  sessionKey        String?     @map("session_key")
  providerSessionId String?     @map("provider_session_id")
  isPersisted       Boolean     @default(false) @map("is_persisted")
  lastSyncedAt      DateTime?   @map("last_synced_at")
  metadata          Json?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  instance          BotInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("bot_session_metadata")
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  actorEmail String?  @map("actor_email")
  actorRole  String?  @map("actor_role")
  category   String
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([category, createdAt])
  @@map("audit_events")
}

model BotEvent {
  id        String               @id @default(cuid())
  userId    String               @map("user_id")
  instanceId String?             @map("instance_id")
  level     String               @default("info")
  code      String
  status    BotConnectionStatus?
  provider  String?
  message   String
  details   Json?
  createdAt DateTime             @default(now()) @map("created_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance  BotInstance?         @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([instanceId, createdAt])
  @@map("bot_events")
}

model ServiceCategory {
  categoryId   BigInt    @id @default(autoincrement()) @map("category_id")
  categoryName String    @unique @map("category_name")
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  services     Service[]

  @@map("service_categories")
}

model Service {
  serviceId              BigInt                    @id @default(autoincrement()) @map("service_id")
  serviceName            String                    @unique @map("service_name")
  defaultDurationMin     Int                       @map("default_duration_min")
  basePrice              Decimal?                  @map("base_price") @db.Decimal(10, 2)
  materialsCost          Decimal?                  @map("materials_cost") @db.Decimal(10, 2)
  category               String?
  categoryId             BigInt?                   @map("category_id")
  emoji                  String?
  displayOrder           Int                       @default(0) @map("display_order")
  isActive               Boolean                   @default(true) @map("is_active")
  serviceCategory        ServiceCategory?          @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  synonyms               ServiceSynonym[]
  allergens              ServiceAllergen[]
  professionalServices   ProfessionalService[]
  appointmentServices    AppointmentService[]
  chatSessionsAsPrompt   ChatSession[]             @relation("ChatSessionLastService")
  appointmentHolds       AppointmentHold[]

  @@map("services")
}

model ServiceSynonym {
  serviceId BigInt  @map("service_id")
  synonym   String
  service   Service @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)

  @@id([serviceId, synonym])
  @@map("service_synonyms")
}

model ServiceAllergen {
  serviceId BigInt  @map("service_id")
  allergen  String
  service   Service @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)

  @@id([serviceId, allergen])
  @@map("service_allergens")
}

model Professional {
  professionalId          BigInt                         @id @default(autoincrement()) @map("professional_id")
  fullName                String                         @map("full_name")
  isActive                Boolean                        @default(true) @map("is_active")
  emails                  ProfessionalEmail[]
  professionalServices    ProfessionalService[]
  appointments            Appointment[]
  unavailableWeekdays     ProfessionalUnavailableWeekday[]
  chatSessionsAsPrompt    ChatSession[]                  @relation("ChatSessionLastProfessional")
  appointmentHolds        AppointmentHold[]

  @@map("professionals")
}

model ProfessionalEmail {
  professionalId BigInt       @map("professional_id")
  email          String       @unique
  professional   Professional @relation(fields: [professionalId], references: [professionalId], onDelete: Cascade)

  @@id([professionalId, email])
  @@map("professional_emails")
}

model ProfessionalService {
  professionalId BigInt       @map("professional_id")
  serviceId      BigInt       @map("service_id")
  professional   Professional @relation(fields: [professionalId], references: [professionalId], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [serviceId], onDelete: Restrict)

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

model ProfessionalUnavailableWeekday {
  professionalId BigInt       @map("professional_id")
  weekday        Int
  professional   Professional @relation(fields: [professionalId], references: [professionalId], onDelete: Cascade)

  @@id([professionalId, weekday])
  @@map("professional_unavailable_weekdays")
}

model Client {
  clientId   BigInt          @id @default(autoincrement()) @map("client_id")
  fullName   String          @map("full_name")
  contacts   ClientContact[]
  appointments Appointment[]

  @@map("clients")
}

model ClientContact {
  clientId BigInt @map("client_id")
  type     String
  value    String @unique
  client   Client @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@id([clientId, type, value])
  @@map("client_contacts")
}

model Appointment {
  appointmentId         BigInt               @id @default(autoincrement()) @map("appointment_id")
  clientId              BigInt               @map("client_id")
  professionalId        BigInt               @map("professional_id")
  startTime             DateTime             @map("start_time")
  endTime               DateTime             @map("end_time")
  status                String
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  client                Client               @relation(fields: [clientId], references: [clientId], onDelete: Restrict)
  professional          Professional         @relation(fields: [professionalId], references: [professionalId], onDelete: Restrict)
  appointmentCalendar   AppointmentCalendar?
  appointmentServices   AppointmentService[]
  appointmentFlag       AppointmentFlag?

  @@index([startTime], map: "ix_appointments_start_time")
  @@map("appointments")
}

model AppointmentCalendar {
  appointmentId BigInt      @id @map("appointment_id")
  provider      String      @default("gcal")
  eventId       String      @unique @map("event_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)

  @@map("appointment_calendar")
}

model AppointmentService {
  appointmentId BigInt      @map("appointment_id")
  serviceId     BigInt      @map("service_id")
  durationMin   Int         @map("duration_min")
  appointment   Appointment @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [serviceId], onDelete: Restrict)

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

model AppointmentFlag {
  appointmentId  BigInt      @id @map("appointment_id")
  confirmAskedAt DateTime?   @map("confirm_asked_at")
  reviewAskedAt  DateTime?   @map("review_asked_at")
  appointment    Appointment @relation(fields: [appointmentId], references: [appointmentId], onDelete: Cascade)

  @@map("appointment_flags")
}

model SalonBusinessHour {
  weekday   Int      @id
  openTime  String?  @map("open_time")
  closeTime String?  @map("close_time")
  isClosed  Boolean  @default(false) @map("is_closed")

  @@map("salon_business_hours")
}

model SalonLunchBreak {
  lunchBreakId BigInt  @id @default(autoincrement()) @map("lunch_break_id")
  weekday      Int
  startTime    String  @map("start_time")
  endTime      String  @map("end_time")

  @@map("salon_lunch_breaks")
}

model ChatSession {
  chatId                          String        @id @map("chat_id")
  phoneE164                       String?       @map("phone_e164")
  lang                            String        @default("it")
  firstSeenAt                     DateTime?     @map("first_seen_at")
  lastActiveAt                    DateTime?     @map("last_active_at")
  lastGreetAt                     DateTime?     @map("last_greet_at")
  privacyVersion                  Int?          @map("privacy_version")
  privacySentAt                   DateTime?     @map("privacy_sent_at")
  lastReviewPromptAt              DateTime?     @map("last_review_prompt_at")
  lastReviewPromptEventId         String?       @map("last_review_prompt_event_id")
  lastReviewPromptServiceId       BigInt?       @map("last_review_prompt_service_id")
  lastReviewPromptProfessionalId  BigInt?       @map("last_review_prompt_professional_id")
  lastReviewReplyAt               DateTime?     @map("last_review_reply_at")
  reminderChoice                  Int?          @map("reminder_choice")
  lastReviewPromptService         Service?      @relation("ChatSessionLastService", fields: [lastReviewPromptServiceId], references: [serviceId], onDelete: SetNull)
  lastReviewPromptProfessional    Professional? @relation("ChatSessionLastProfessional", fields: [lastReviewPromptProfessionalId], references: [professionalId], onDelete: SetNull)
  messages                        ChatMessage[]
  holds                           AppointmentHold[]
  runtimeState                    ChatSessionRuntimeState?

  @@map("chat_sessions")
}

model ChatSessionRuntimeState {
  chatId    String      @id @map("chat_id")
  memoryJson Json?      @map("memory_json")
  updatedAt DateTime    @default(now()) @map("updated_at")
  session   ChatSession @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@map("chat_session_runtime_state")
}

model ChatMessage {
  messageId  BigInt      @id @default(autoincrement()) @map("message_id")
  chatId     String      @map("chat_id")
  direction  String
  body       String
  createdAt  DateTime    @default(now()) @map("created_at")
  chatSession ChatSession @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("chat_messages")
}

model AppointmentHold {
  holdId          BigInt       @id @default(autoincrement()) @map("hold_id")
  chatId          String       @map("chat_id")
  professionalId  BigInt       @map("professional_id")
  serviceId       BigInt?      @map("service_id")
  startTime       DateTime     @map("start_time")
  endTime         DateTime     @map("end_time")
  createdAt       DateTime     @default(now()) @map("created_at")
  expiresAt       DateTime     @map("expires_at")
  status          String       @default("active")
  chatSession     ChatSession  @relation(fields: [chatId], references: [chatId], onDelete: Cascade)
  professional    Professional @relation(fields: [professionalId], references: [professionalId], onDelete: Cascade)
  service         Service?     @relation(fields: [serviceId], references: [serviceId], onDelete: SetNull)

  @@index([status, expiresAt])
  @@map("appointment_holds")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

