NODE_ENV=development

# Frontend locale
VITE_API_BASE_URL=http://localhost:4000
VITE_ENV_LABEL=Locale
FRONTEND_BASE_PATH=/
APP_BASE_URL=http://localhost:5173/#/login

# Backend API
API_PORT=4000
JWT_SECRET=change-me-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8091,http://127.0.0.1:8091
BOT_WORKER_BASE_URL=http://localhost:4001
INTERNAL_SERVICE_TOKEN=change-me-internal-token
ALLOW_SELF_REGISTRATION=true
ENABLE_BOT_SQL_CONSOLE=true
ALLOW_CLIENT_BOT_START=true
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=whatsapp_ai_session
AUTH_COOKIE_SECURE=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:dev@example.com

# Bot worker
BOT_WORKER_PORT=4001
BOT_PROVIDER=mock
BOT_SESSION_DIR=./bot-sessions

# PostgreSQL
POSTGRES_USER=whatsapp_ai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=whatsapp_ai
DATABASE_URL=postgresql://whatsapp_ai:change-me@localhost:5433/whatsapp_ai?schema=public

# Legacy bot compatibility / eventuale integrazione successiva
SESSION_PATH=./session.json
LOG_LEVEL=info
OLLAMA_URL=http://localhost:11434
CALENDAR_ID=
LICENSE_PASSPHRASE=
