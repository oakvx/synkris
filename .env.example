# Configurazione del SALONE. Il tecnico completa questi valori una sola volta.
# Questo e solo un esempio: .env con i valori reali resta fuori da Git e dallo ZIP.
# POSTGRES_PASSWORD deve essere un token URL-safe (lo script genera 64 cifre hex).
POSTGRES_PASSWORD=SOSTITUISCI_PASSWORD_CASUALE
ADMIN_TOKEN=SOSTITUISCI_TOKEN_CASUALE_MIN_32
DASHBOARD_PASSWORD=SOSTITUISCI_PASSWORD_CASUALE_MIN_12
CALENDAR_ID=calendario-del-salone@group.calendar.google.com
APP_HWID=HWID_ASSOCIATO_ALLA_LICENZA
TZ=Europe/Rome
SALON_NAME=Salone
CALENDAR_OUTBOX_ENABLED=1
CALENDAR_INBOUND_SYNC=1
OLLAMA_URL=http://ollama:11434
AI_ENABLED=0
AI_INTENT_ENABLED=0
OLLAMA_MODEL=
OLLAMA_INTENT_MODEL=

# AVVISI ESTERNI (opzionali). Non vengono inviati dati dei clienti.
# Con ALERT_EMAIL_ENABLED=0 synk non contatta nessun server SMTP.
ALERT_EMAIL_ENABLED=0
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Prenotazione multipla via WhatsApp: attivare solo dopo test end-to-end.
MULTI_BOOKING_WHATSAPP_ENABLED=0

# Conservazione cronologia conversazioni locali (7..730 giorni). Gli appuntamenti sono separati.
CHAT_RETENTION_DAYS=90

# Sandbox Chromium attiva. Non disabilitarla senza una valutazione tecnica
# dell'isolamento del container/VM. Alcuni host Docker richiedono configurazione.
CHROME_NO_SANDBOX=0
