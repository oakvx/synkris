NODE_ENV=development

# Frontend statico (GitHub Pages)
VITE_API_BASE_URL=http://localhost:8080
GITHUB_PAGES_BASE=/

# Backend API
API_PORT=4000
JWT_SECRET=change-me-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173,https://your-user.github.io
BOT_WORKER_BASE_URL=http://localhost:4001
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# Bot worker
BOT_WORKER_PORT=4001
BOT_PROVIDER=mock
BOT_SESSION_DIR=./bot-sessions

# PostgreSQL
POSTGRES_USER=whatsapp_ai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=whatsapp_ai
DATABASE_URL=postgresql://whatsapp_ai:change-me@localhost:5432/whatsapp_ai?schema=public

# Legacy bot compatibility / eventuale integrazione successiva
SESSION_PATH=./session.json
LOG_LEVEL=info
OLLAMA_URL=http://localhost:11434
CALENDAR_ID=
LICENSE_PASSPHRASE=
